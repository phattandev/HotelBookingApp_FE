<file path="src/components/ProtectedRoute.tsx">
import React from 'react';
import { Navigate, Outlet } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';

interface ProtectedRouteProps {
  allowedRoles?: string[];
}

const ProtectedRoute: React.FC<ProtectedRouteProps> = ({ allowedRoles }) => {
  const { user, isAuthenticated, isLoading } = useAuth();

  if (isLoading) {
    return <div className="flex justify-center items-center h-screen font-semibold text-indigo-600">Đang tải cấu hình...</div>;
  }

  // 1. Chưa đăng nhập -> Đẩy về trang Login
  if (!isAuthenticated || !user) {
    return <Navigate to="/login" replace />;
  }

  // 2. Có quy định Role nhưng User không khớp -> Đẩy về trang báo lỗi 403
  if (allowedRoles && allowedRoles.length > 0 && !allowedRoles.includes(user.Role.toLowerCase())) {
    return <Navigate to="/unauthorized" replace />;
  }

  // 3. Hợp lệ -> Cho phép render Layout/Page bên trong
  return <Outlet />;
};

export default ProtectedRoute;
</file>

<file path="src/pages/admin/HotelApproval.tsx">
import React, { useEffect, useState } from 'react';
import api from '../../services/api';

const HotelApproval: React.FC = () => {
  const [pendingHotels, setPendingHotels] = useState<any[]>([]);

  useEffect(() => {
    fetchPendingHotels();
  }, []);

  const fetchPendingHotels = async () => {
    // Giả định API GET /api/hotels/pending
    const res = await api.get('/hotels/pending');
    setPendingHotels(res.data.data);
  };

  const handleReview = async (id: string, action: 'Approve' | 'Reject') => {
    if (!window.confirm(`Bạn có chắc muốn ${action === 'Approve' ? 'DUYỆT' : 'TỪ CHỐI'} khách sạn này?`)) return;
    try {
      await api.put(`/hotels/${id}/review`, { action });
      fetchPendingHotels(); // Tải lại danh sách
    } catch (e) { alert('Lỗi xử lý'); }
  };

  return (
    <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      <h2 className="text-xl font-bold text-red-800 mb-6">Xét duyệt Đăng ký Khách sạn</h2>
      
      <div className="space-y-4">
        {pendingHotels.length === 0 ? <p className="text-gray-500 text-center py-8">Không có đơn đăng ký nào chờ duyệt.</p> : pendingHotels.map(h => (
          <div key={h.id} className="border border-yellow-200 bg-yellow-50/30 p-4 rounded-lg flex justify-between items-center">
            <div>
              <h3 className="font-bold text-lg text-gray-900">{h.name}</h3>
              <p className="text-sm text-gray-600 mt-1">📄 <span className="font-semibold">MST:</span> {h.taxCode}</p>
              <p className="text-sm text-gray-600">{h.address}</p>
              <p className="text-sm text-gray-600">{h.contactPhone} | ✉️ {h.contactEmail}</p>
            </div>
            <div className="flex space-x-2">
              <button onClick={() => handleReview(h.id, 'Reject')} className="px-4 py-2 bg-red-100 text-red-700 font-bold rounded-lg hover:bg-red-200">Từ Chối</button>
              <button onClick={() => handleReview(h.id, 'Approve')} className="px-4 py-2 bg-green-600 text-white font-bold rounded-lg hover:bg-green-700">Phê Duyệt</button>
            </div>

          </div>
        ))}
      </div>
    </div>
  );
};
export default HotelApproval;
</file>

<file path="src/pages/admin/ProvinceManagement.tsx">
import React, { useEffect, useState } from 'react';
import api from '../../services/api';

interface Province {
  id: string;
  code: string;
  name: string;
  slug: string;
  type: string;
}

const ProvinceManagement: React.FC = () => {
  const [provinces, setProvinces] = useState<Province[]>([]);
  const [loading, setLoading] = useState(true);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingProvince, setEditingProvince] = useState<Province | null>(null);

  // Form States
  const [name, setName] = useState('');
  const [code, setCode] = useState('');
  const [type, setType] = useState('Tỉnh');

  const fetchProvinces = async () => {
    try {
      setLoading(true);
      const res = await api.get('/provinces');
      // Dựa trên cấu trúc Wrapper Response.cs, dữ liệu thực nằm ở res.data.data
      setProvinces(res.data.data || []);
    } catch (err) {
      console.error('Lỗi tải danh mục Tỉnh/Thành', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchProvinces();
  }, []);

  const openAddModal = () => {
    setEditingProvince(null);
    setName(''); setCode(''); setType('Tỉnh');
    setIsModalOpen(true);
  };

  const openEditModal = (province: Province) => {
    setEditingProvince(province);
    setName(province.name);
    setCode(province.code);
    setType(province.type);
    setIsModalOpen(true);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    // Tạo slug tự động đơn giản từ tên (Backend cũng có thể tự xử lý qua MediatR)
    const slug = name.toLowerCase().replace(/ /g, '-');

    try {
      if (editingProvince) {
        // Luồng cập nhật (PUT)
        await api.put('/provinces', { id: editingProvince.id, code, name, slug, type });
      } else {
        // Luồng tạo mới (POST)
        await api.post('/provinces', { code, name, slug, type });
      }
      setIsModalOpen(false);
      fetchProvinces();
    } catch (err: any) {
      alert(err.response?.data?.Message || 'Thao tác thất bại');
    }
  };

  const handleDelete = async (id: string) => {
    if (!window.confirm('Bạn có chắc chắn muốn xóa Tỉnh/Thành này? Toàn bộ phường/xã liên kết có thể bị ảnh hưởng.')) return;
    try {
      await api.delete(`/provinces/${id}`);
      fetchProvinces();
    } catch (err: any) {
      alert(err.response?.data?.Message || 'Xóa thất bại');
    }
  };

  if (loading) return <div className="text-center p-12 text-gray-500">Đang đồng bộ dữ liệu địa điểm...</div>;

  return (
    <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
      <div className="flex justify-between items-center mb-6">
        <div>
          <h2 className="text-xl font-bold text-gray-800">Cấu hình Tỉnh / Thành phố</h2>
          <p className="text-sm text-gray-500">Danh mục phân vùng địa lý chuẩn cho toàn sàn marketplace</p>
        </div>
        <button 
          onClick={openAddModal}
          className="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium text-sm transition shadow-sm"
        >
          + Thêm Tỉnh/Thành
        </button>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left border-collapse">
          <thead>
            <tr className="bg-gray-50 border-b border-gray-200 text-sm text-gray-600 font-semibold">
              <th className="p-3">Mã Vùng (Code)</th>
              <th className="p-3">Tên Địa Danh</th>
              <th className="p-3">Phân Loại</th>
              <th className="p-3">Đường Dẫn (Slug)</th>
              <th className="p-3 text-right">Hành Động</th>
            </tr>
          </thead>
          <tbody>
            {provinces.length === 0 ? (
              <tr><td colSpan={5} className="p-6 text-center text-gray-400 text-sm">Chưa có dữ liệu vùng miền. Vui lòng chạy seeder hoặc thêm mới.</td></tr>
            ) : provinces.map((p) => (
              <tr key={p.id} className="border-b border-gray-100 hover:bg-gray-50 text-sm text-gray-700">
                <td className="p-3 font-mono font-semibold text-gray-900">{p.code}</td>
                <td className="p-3 font-medium text-gray-800">{p.name}</td>
                <td className="p-3">
                  <span className={`px-2 py-0.5 text-xs font-medium rounded-full ${p.type === 'Thành phố' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700'}`}>
                    {p.type}
                  </span>
                </td>
                <td className="p-3 text-gray-400 font-mono text-xs">{p.slug}</td>
                <td className="p-3 text-right space-x-2">
                  <button onClick={() => openEditModal(p)} className="text-xs bg-gray-100 hover:bg-indigo-50 text-gray-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-md transition font-medium">
                    Sửa
                  </button>
                  <button onClick={() => handleDelete(p.id)} className="text-xs bg-gray-100 hover:bg-red-50 text-gray-600 hover:text-red-600 px-2.5 py-1.5 rounded-md transition font-medium">
                    Xóa
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* MODAL ĐIỀU HƯỚNG THÊM/SỬA */}
      {isModalOpen && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 animate-fade-in">
          <div className="bg-white rounded-xl shadow-xl w-full max-w-md p-6 border border-gray-100">
            <h3 className="text-lg font-bold text-gray-900 mb-4 border-b pb-2">
              {editingProvince ? 'Cập nhật thông tin địa danh' : 'Thêm Tỉnh / Thành phố mới'}
            </h3>
            
            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase text-gray-500 mb-1">Mã vùng hành chính (Code)</label>
                <input type="text" required value={code} onChange={(e) => setCode(e.target.value)} placeholder="Ví dụ: 01, 79..." className="w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:outline-none" />
              </div>
              <div>
                <label className="block text-xs font-bold uppercase text-gray-500 mb-1">Tên Tỉnh / Thành phố</label>
                <input type="text" required value={name} onChange={(e) => setName(e.target.value)} placeholder="Ví dụ: Thành phố Hồ Chí Minh" className="w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:outline-none" />
              </div>
              <div>
                <label className="block text-xs font-bold uppercase text-gray-500 mb-1">Cấp hành chính</label>
                <select value={type} onChange={(e) => setType(e.target.value)} className="w-full border border-gray-200 px-3 py-2 rounded-lg text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                  <option value="Tỉnh">Tỉnh</option>
                  <option value="Thành phố">Thành phố trực thuộc Trung Ương</option>
                </select>
              </div>

              <div className="flex justify-end space-x-3 pt-4 border-t mt-6">
                <button type="button" onClick={() => setIsModalOpen(false)} className="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">Hủy</button>
                <button type="submit" className="px-4 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium shadow-sm">
                  {editingProvince ? 'Cập Nhật' : 'Tạo Địa Danh'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default ProvinceManagement;
</file>

