import React from 'react';
import { Routes, Route, Navigate } from 'react-router-dom';

// --- Import Component Bảo vệ ---
import ProtectedRoute from './components/ProtectedRoute';

// --- Import Layouts ---
import MainLayout from './layouts/MainLayout';
import AdminLayout from './layouts/AdminLayout';
import PartnerLayout from './layouts/PartnerLayout';

// --- Import Pages ---
import Login from './pages/auth/Login';
import Profile from './pages/profile/Profile'; // Chắc chắn bạn đã có file này từ bước trước

// Component phụ báo lỗi
const Unauthorized = () => <div className="p-10 text-red-600 text-2xl font-bold text-center">403 - Bạn không có quyền truy cập khu vực này.</div>;


// Import components staffManager
import StaffManagement from './pages/partner/StaffManagement';
import ProvinceManagement from './pages/admin/ProvinceManagement';

import HotelApproval from './pages/admin/HotelApproval';
import HotelCatalog from './pages/partner/HotelCatalog';

const App: React.FC = () => {
  return (
    <Routes>
      {/* 1. Các Route Public (Không cần đăng nhập vẫn vào được) */}
      <Route path="/login" element={<Login />} />
      <Route path="/unauthorized" element={<Unauthorized />} />

      {/* 2. Cụm Router dùng MainLayout (Dành cho Khách hàng vãng lai / Khách đăng nhập) */}
      <Route element={<MainLayout />}>
        {/* Cho phép khách chưa login xem trang chủ */}
        <Route path="/" element={<div className="h-[80vh] flex items-center justify-center text-3xl font-bold text-indigo-500">Trang chủ Booking</div>} />
        
        {/* Xem Profile bắt buộc phải Login (Bất kỳ Role nào) */}
        <Route element={<ProtectedRoute />}>
          <Route path="/profile" element={<Profile />} />
        </Route>
      </Route>

      {/* 3. Cụm Router dành riêng cho ADMIN (Bảo vệ nghiêm ngặt) */}
      <Route element={<ProtectedRoute allowedRoles={['admin']} />}>
        <Route element={<AdminLayout />}>
          <Route path="/admin" element={<div className="p-8 font-bold text-xl">Chào mừng Admin!</div>} />
          
          {/* SỬA DÒNG NÀY: Gắn trang quản lý địa điểm vào */}
          <Route path="/admin/provinces" element={<ProvinceManagement />} />
          
        </Route>
      </Route>

      {/* 4. Cụm Router dành riêng cho PARTNER (Doanh nghiệp) */}
      <Route element={<ProtectedRoute allowedRoles={['partner']} />}>
        <Route element={<PartnerLayout />}>
          <Route path="/partner" element={<div className="p-8 font-bold text-xl">Dashboard Doanh Nghiệp Partner</div>} />
          <Route path="/admin/approvals" element={<HotelApproval />} /> {/* Khớp đường dẫn */}

          {/* SỬA DÒNG NÀY: Gọi Component StaffManagement vào đây */}
          <Route path="/partner/staff" element={<StaffManagement />} />
          <Route path="/partner/hotels" element={<HotelCatalog />} /> {/* Khớp đường dẫn */}

        </Route>
      </Route>

      {/* Bắt lỗi đường dẫn không tồn tại (404) đẩy về trang chủ */}
      <Route path="*" element={<Navigate to="/" replace />} />
    </Routes>
  );
};

export default App;
</file>

